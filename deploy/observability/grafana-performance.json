{
  "title": "Dublancer Performance and Capacity",
  "uid": "dublancer-performance-capacity",
  "schemaVersion": 39,
  "tags": ["dublancer", "performance", "capacity"],
  "refresh": "30s",
  "panels": [
    {"id": 1, "title": "HTTP latency percentiles", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(dublancer_http_request_duration_ms_bucket[5m])))", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(dublancer_http_request_duration_ms_bucket[5m])))", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(dublancer_http_request_duration_ms_bucket[5m])))", "legendFormat": "p99"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "title": "Worker throughput", "type": "timeseries", "targets": [{"expr": "sum by (queue, result) (rate(dublancer_queue_jobs_total[5m]))"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}},
    {"id": 3, "title": "Search latency", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, provider) (rate(dublancer_search_duration_ms_bucket[5m])))"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
    {"id": 4, "title": "Cache invalidation propagation", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, destination_region) (rate(dublancer_cache_invalidation_duration_ms_bucket[5m])))"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}}
  ]
}
