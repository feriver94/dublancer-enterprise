DATABASE_URL="postgresql://dublancer:change-me@localhost:5432/dublancer?schema=public"
REDIS_URL="redis://localhost:6379"
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
EXPOSE_DEVELOPMENT_TOKENS="false"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
INTERNAL_PUBLISHER_SECRET="replace-with-high-entropy-secret"
INTERNAL_NOTIFICATION_SECRET="replace-with-high-entropy-secret"
INTERNAL_EMAIL_SECRET="replace-with-high-entropy-secret"
INTERNAL_CHAT_MAINTENANCE_SECRET="replace-with-high-entropy-secret"
INTERNAL_WORKER_SECRET="replace-with-high-entropy-secret"
OBSERVABILITY_EXPORT_SECRET="replace-with-high-entropy-secret"

# Enterprise integration credentials and network policy
INTEGRATION_API_KEY_PEPPER="replace-with-high-entropy-secret"
INTEGRATION_ALLOW_PRIVATE_NETWORK="false"

# Enterprise identity encryption and WebAuthn
IDENTITY_ENCRYPTION_KEY="replace-with-32-byte-base64-or-64-character-hex"
MFA_BACKUP_CODE_PEPPER="replace-with-high-entropy-secret"
WEBAUTHN_ORIGIN="http://localhost:3000"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Dublancer Enterprise"

# OpenTelemetry OTLP export
OTEL_SERVICE_NAME="dublancer-enterprise"
OTEL_EXPORTER_OTLP_ENDPOINT="https://otel-collector.example.com"
OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer%20replace-me"
OTEL_METRIC_EXPORT_INTERVAL="60000"
DEPLOYMENT_ENVIRONMENT="development"
DEPLOYMENT_REGION="uae-north"
DEPLOYMENT_REGIONS="uae-north,europe-west"
DISASTER_RECOVERY_REGION="europe-west"
RELEASE_COLOR="blue"
APP_VERSION="1.0.0"

# Multi-region cache coordination and federated search
CACHE_INVALIDATION_SECRET="replace-with-high-entropy-secret"
CACHE_INVALIDATION_PEERS="https://eu.example.com/api/internal/cache/invalidate"
SEARCH_FEDERATION_ENDPOINTS="https://search.example.com/query"
SEARCH_FEDERATION_TOKEN="replace-me"
SEARCH_FEDERATION_TIMEOUT_MS="800"

# Alert receiver used by the OpenTelemetry/Alertmanager deployment
ALERTMANAGER_WEBHOOK_URL="https://alerts.example.com/dublancer"

# Provider-neutral storage signing broker
STORAGE_PROVIDER_KEY="s3-compatible"
STORAGE_SIGNING_ENDPOINT="https://storage-broker.example.com"
STORAGE_SIGNING_TOKEN="replace-me"

# OpenAI-compatible AI endpoint (may be any compatible provider)
AI_PROVIDER_KEY="enterprise-ai"
AI_PROVIDER_BASE_URL="https://ai-provider.example.com/v1"
AI_PROVIDER_API_KEY="replace-me"

# Payment orchestration provider/broker
PAYMENT_PROVIDER_KEY="payment-broker"
PAYMENT_PROVIDER_BASE_URL="https://payments.example.com"
PAYMENT_PROVIDER_API_KEY="replace-me"
PAYMENT_WEBHOOK_SECRET="replace-me"

# Outbound notification broker (email/SMS/push)
NOTIFICATION_PROVIDER_BASE_URL="https://notifications.example.com"
NOTIFICATION_PROVIDER_API_KEY="replace-me"

# Malware scanning broker
FILE_SCAN_PROVIDER_KEY="malware-scan-broker"
FILE_SCAN_PROVIDER_BASE_URL="https://scanner.example.com"
FILE_SCAN_PROVIDER_API_KEY="replace-me"
FILE_SCAN_WEBHOOK_SECRET="replace-me"

# Optional scalable runtime adapters
QUEUE_PROVIDER_KEY="database-outbox"
SEARCH_PROVIDER_KEY="postgresql"
CACHE_PROVIDER_KEY="redis"
