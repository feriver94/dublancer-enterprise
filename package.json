{
  "name": "dublancer-enterprise",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "lint": "eslint --quiet",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:commercial": "node scripts/verify-commercial-flow.mjs",
    "test:phase3:runtime": "node scripts/verify-phase3-runtime.mjs",
    "test:phase4:runtime": "node scripts/verify-phase4-runtime.mjs",
    "test:phase5:runtime": "node scripts/verify-phase5-runtime.mjs",
    "test:phase6:runtime": "node scripts/verify-phase6-runtime.mjs",
    "test:phase7:runtime": "node scripts/verify-phase7-runtime.mjs",
    "test:phase8:runtime": "node scripts/verify-phase8-runtime.mjs",
    "test:phase9:runtime": "node scripts/verify-phase9-runtime.mjs",
    "test:phase10:runtime": "node scripts/verify-phase10-runtime.mjs",
    "test:sprint1:runtime": "node scripts/verify-phase10-runtime.mjs",
    "test:phase-a:runtime": "node scripts/verify-phase-a-runtime.mjs",
    "test:phase-b:runtime": "node scripts/verify-phase-b-runtime.mjs",
    "test:phase-c:runtime": "node scripts/verify-phase-c-runtime.mjs",
    "test:browser": "playwright test",
    "test:browser:list": "playwright test --list",
    "load:test": "node scripts/load-test.mjs",
    "verify:locales": "node scripts/verify-locales.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:environment": "node scripts/validate-environment.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "verify:ui": "node scripts/verify-ui-consistency.mjs",
    "verify:supply-chain": "node scripts/verify-supply-chain.mjs",
    "verify:release-docs": "node scripts/verify-release-documentation.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "verify:release": "prisma validate && prisma generate && npm run verify:migrations && npm run verify:locales && npm run verify:security && npm run verify:secrets && npm test && tsc --noEmit && eslint --quiet && next build",
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.44.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.6",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "0.4.1",
    "@electric-sql/pglite-socket": "0.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "ajv@8.20.0": {
      "fast-uri": "3.1.5"
    }
  }
}
