{
  "name": "dublancer-enterprise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --quiet",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:commercial": "node scripts/verify-commercial-flow.mjs",
    "test:phase3:runtime": "node scripts/verify-phase3-runtime.mjs",
    "test:phase4:runtime": "node scripts/verify-phase4-runtime.mjs",
    "test:phase5:runtime": "node scripts/verify-phase5-runtime.mjs",
    "test:phase6:runtime": "node scripts/verify-phase6-runtime.mjs",
    "test:phase7:runtime": "node scripts/verify-phase7-runtime.mjs",
    "test:phase8:runtime": "node scripts/verify-phase8-runtime.mjs",
    "test:phase9:runtime": "node scripts/verify-phase9-runtime.mjs",
    "load:test": "node scripts/load-test.mjs",
    "verify:locales": "node scripts/verify-locales.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:environment": "node scripts/validate-environment.mjs",
    "verify:production-config": "node scripts/verify-production-config.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "verify:supply-chain": "node scripts/verify-supply-chain.mjs",
    "verify:release": "prisma validate && prisma generate && npm run verify:migrations && npm run verify:locales && npm run verify:security && npm run verify:secrets && npm test && tsc --noEmit && eslint --quiet && next build",
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.44.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "next": "^16.2.12",
    "next-intl": "^4.13.2",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1",
    "@electric-sql/pglite-socket": "0.1.1",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "^7.8.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
